// Prisma schema — painel admin MS Móveis Sob Medida
// A URL de conexão fica em prisma.config.ts (padrão Prisma 7), não aqui.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

enum Role {
  ADMIN
  MEMBER
}

model Orcamento {
  id            String          @id @default(cuid())
  nome          String
  telefone      String
  email         String
  tipoProjeto   String[]
  mensagem      String
  incluiProjeto Boolean         @default(true)
  status        OrcamentoStatus @default(NOVO)
  valorEstimado Decimal?        @db.Decimal(10, 2)
  notasInternas String?
  origem        Origem          @default(SITE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  contasReceber ContaReceber[]
  contrato      Contrato?
}

enum OrcamentoStatus {
  NOVO
  EM_ANDAMENTO
  APROVADO
  RECUSADO
}

enum Origem {
  SITE
  MANUAL
}

model ContaPagar {
  id                     String                  @id @default(cuid())
  descricao              String
  fornecedor             String?
  categoria              CategoriaPagar          @default(OUTROS)
  valor                  Decimal                 @db.Decimal(10, 2)
  vencimento             DateTime
  status                 StatusPagamento         @default(PENDENTE)
  dataPagamento          DateTime?
  grupoRecorrencia       String?
  frequenciaRecorrencia  FrequenciaRecorrencia?
  numeroOcorrencia       Int?
  totalOcorrencias       Int?
  notasInternas          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

enum FrequenciaRecorrencia {
  SEMANAL
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum CategoriaPagar {
  MATERIAL
  FORNECEDOR
  SALARIOS
  ALUGUEL
  IMPOSTOS
  MARKETING
  OUTROS
}

enum StatusPagamento {
  PENDENTE
  PAGO
}

model ContaReceber {
  id                String            @id @default(cuid())
  cliente           String
  telefone          String?
  email             String?
  valor             Decimal           @db.Decimal(10, 2)
  vencimento        DateTime
  status            StatusRecebimento @default(PENDENTE)
  dataRecebimento   DateTime?
  parcela           Int               @default(1)
  totalParcelas     Int               @default(1)
  grupoParcelamento String?
  notasInternas     String?
  orcamentoId       String?
  orcamento         Orcamento?        @relation(fields: [orcamentoId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

enum StatusRecebimento {
  PENDENTE
  RECEBIDO
}

model Colaborador {
  id            String        @id @default(cuid())
  nome          String
  cpf           String        @unique
  cargo         String
  telefone      String?
  email         String?
  dataAdmissao  DateTime
  dataDemissao  DateTime?
  salario       Decimal?      @db.Decimal(10, 2)
  pinHash       String
  notasInternas String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ferias        Ferias[]
  afastamentos  Afastamento[]
  pontos        Ponto[]
}

model Ferias {
  id                      String      @id @default(cuid())
  colaboradorId           String
  colaborador             Colaborador @relation(fields: [colaboradorId], references: [id])
  periodoAquisitivoInicio DateTime
  periodoAquisitivoFim    DateTime
  diasDireito             Int         @default(30)
  diasGozados             Int         @default(0)
  dataGozoInicio          DateTime?
  dataGozoFim             DateTime?
  notasInternas           String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model Afastamento {
  id            String          @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador     @relation(fields: [colaboradorId], references: [id])
  tipo          TipoAfastamento @default(OUTROS)
  dataInicio    DateTime
  dataFim       DateTime?
  motivo        String?
  notasInternas String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum TipoAfastamento {
  ATESTADO
  LICENCA_MEDICA
  INSS_AUXILIO_DOENCA
  MATERNIDADE
  PATERNIDADE
  LUTO
  OUTROS
}

model Ponto {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  tipo          TipoPonto
  dataHora      DateTime    @default(now())
  notasInternas String?
  createdAt     DateTime    @default(now())
}

enum TipoPonto {
  ENTRADA
  SAIDA
}

model Contrato {
  id                   String          @id @default(cuid())
  orcamentoId          String          @unique
  orcamento            Orcamento       @relation(fields: [orcamentoId], references: [id])
  tipoContratante      TipoContratante @default(PESSOA_FISICA)
  contratanteNome      String
  contratanteDocumento String
  contratanteEndereco  String
  contratanteCep       String
  contratanteBairro    String
  contratanteCidade    String
  contratanteUf        String
  contratanteRepNome   String?
  contratanteRepCpf    String?
  contratanteRepRg     String?
  contratanteRepCargo  String?
  enderecoInstalacao   String
  prazoExecucaoDias    Int
  valorTotal           Decimal         @db.Decimal(10, 2)
  valorSinal           Decimal         @db.Decimal(10, 2)
  valorFabricacao      Decimal         @db.Decimal(10, 2)
  valorEntrega         Decimal         @db.Decimal(10, 2)
  foroCidade           String
  foroUf               String
  dataContrato         DateTime        @default(now())
  status               StatusContrato  @default(RASCUNHO)
  notasInternas        String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

enum TipoContratante {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

enum StatusContrato {
  RASCUNHO
  GERADO
  ASSINADO
}

# Copie para .env e preencha com valores reais. Nunca commite o .env de verdade.

# String de conexão do PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ms_moveis_erp?schema=public"

# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-gerado-com-openssl"

# URL pública do site (produção: https://msmoveissobmedida.com.br)
AUTH_URL="http://localhost:3000"

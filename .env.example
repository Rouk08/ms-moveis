# Copie para .env e preencha com valores reais. Nunca commite o .env de verdade.

# String de conexão do PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ms_moveis_erp?schema=public"

# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-gerado-com-openssl"

# URL pública do site (produção: https://msmoveissobmedida.com.br)
AUTH_URL="http://localhost:3000"

# Caixa de e-mail comercial@msmoveissobmedida.com.br (Hostinger)
# Padrão Hostinger: imap.hostinger.com:993 (SSL) / smtp.hostinger.com:465 (SSL)
# Confirme em hPanel > Emails > Mailboxes > Connect apps & devices > Advanced settings
IMAP_HOST="imap.hostinger.com"
IMAP_PORT="993"
IMAP_USER="comercial@msmoveissobmedida.com.br"
IMAP_PASSWORD=""

SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="comercial@msmoveissobmedida.com.br"
SMTP_PASSWORD=""
